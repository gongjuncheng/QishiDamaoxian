<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>硬写版 Mind+ 游戏</title>
    <style>
        body { margin: 0; background: #2c3e50; display: flex; justify-content: center; align-items: center; height: 100vh; font-family: sans-serif; }
        
        /* 主游戏窗口 */
        #game-wrapper {
            position: relative; width: 900px; height: 600px;
            background: url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?q=80&w=900&auto=format&fit=crop') no-repeat center center;
            background-size: cover; border: 4px solid #fff; border-radius: 12px;
            overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        /* 右上角变量面板 */
        .ui-panel {
            position: absolute; top: 10px; right: 10px; background: rgba(0, 0, 0, 0.7);
            color: white; padding: 10px 20px; border-radius: 8px; border: 1px solid #555; min-width: 120px;
        }
        .ui-item { display: flex; justify-content: space-between; padding: 4px 0; font-weight: bold; font-size: 18px; }
        .hp-val { color: #ff5555; }
        .score-val { color: #f1c40f; }

        /* 交互道具 (对应截图中的 角色点击触发广播1) */
        .interact-item {
            position: absolute; left: 40px; top: 40%; width: 70px; height: 70px; 
            background: radial-gradient(circle, #9b59b6, #8e44ad); border-radius: 50%;
            border: 3px solid #fff; cursor: pointer; box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            display: flex; justify-content: center; align-items: center; color: white; font-weight: bold;
            transition: 0.2s; user-select: none;
        }
        .interact-item:hover { transform: scale(1.1); background: radial-gradient(circle, #e67e22, #d35400); }
        .interact-item:active { transform: scale(0.9); }
        .item-label { font-size: 12px; text-align: center; line-height: 1.2;}
    </style>
</head>
<body>

<div id="game-wrapper">
    <!-- UI 变量显示 -->
    <div class="ui-panel">
        <div class="ui-item"><span>❤️ 血量</span><span id="hp-text" class="hp-val">0</span></div>
        <div class="ui-item"><span>⭐ 得分</span><span id="score-text" class="score-val">49</span></div>
    </div>

    <!-- 广播触发道具 (对应图7的 当角色被点击 -> 隐藏 -> 广播消息1) -->
    <div id="trigger-item" class="interact-item" onclick="triggerBroadcast1()">
        <span class="item-label">点击切换<br>场景</span>
    </div>

    <!-- 游戏画布渲染层 -->
    <canvas id="gameCanvas" width="900" height="600"></canvas>
</div>

<script>
// ==========================================
// 1. 变量初始化 (对应图1积木：将变量设为0和49)
// ==========================================
let hp = 0;
let score = 49;
let isSceneChanged = false;

// 玩家对象 (对应 Knight 角色)
const player = {
    x: 200, y: 300, w: 32, h: 44, speed: 5
};

// 敌人数组 (对应游戏中的克隆体)
let enemies = [];

// UI 元素
const hpEl = document.getElementById('hp-text');
const scoreEl = document.getElementById('score-text');
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const wrapper = document.getElementById('game-wrapper');

// ==========================================
// 2. 核心游戏逻辑 (对应图1、图6的无限循环积木)
// ==========================================

// 更新 UI 变量
function updateUI() {
    hpEl.innerText = hp;
    scoreEl.innerText = score;
}

// 生成敌人（克隆体）
function spawnEnemy() {
    // 随机在屏幕边缘生成
    let x, y;
    const side = Math.random();
    if (side < 0.25) { x = 0; y = Math.random() * canvas.height; }
    else if (side < 0.5) { x = canvas.width; y = Math.random() * canvas.height; }
    else if (side < 0.75) { x = Math.random() * canvas.width; y = 0; }
    else { x = Math.random() * canvas.width; y = canvas.height; }

    enemies.push({
        x: x, y: y, w: 40, h: 40,
        // 朝玩家移动的简单 AI
        vx: (player.x - x) / 100,
        vy: (player.y - y) / 100
    });

    // 每隔 0.5~1.5 秒生成一个敌人
    if (hp < 20) { // 如果血量低于20，继续出怪，否则停止出怪（自己控制游戏逻辑）
        setTimeout(spawnEnemy, Math.random() * 1000 + 500);
    }
}

// 碰撞检测函数 (AABB 矩形碰撞检测)
function checkCollision() {
    for (let i = enemies.length - 1; i >= 0; i--) {
        const e = enemies[i];
        // 玩家碰到敌人
        if (player.x < e.x + e.w && player.x + player.w > e.x &&
            player.y < e.y + e.h && player.y + player.h > e.y) {
            
            // 对应图6积木：碰到 Knight -> 将得分增加 1
            score += 1;
            updateUI();
            enemies.splice(i, 1); // 隐藏并删除克隆体
            continue;
        }

        // 对应图6积木：碰到 边缘 -> 将血量增加 1
        // 这里我们让敌人跑出屏幕边缘就扣血
        if (e.x + e.w < 0 || e.x > canvas.width || e.y + e.h < 0 || e.y > canvas.height) {
            hp += 1;
            updateUI();
            enemies.splice(i, 1);
        }
    }
}

// 游戏主循环
function gameLoop() {
    // 清空画布
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // ================== 绘制背景 (对应图8的切换背景) ==================
    if (isSceneChanged) {
        ctx.fillStyle = "#34495e"; // 模拟切换到太空/黑背景
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "white";
        ctx.font = "20px Arial";
        ctx.fillText("场景已切换", 200, 200);
    }

    // ================== 绘制敌人 (对应克隆体) ==================
    enemies.forEach(e => {
        // 画一个紫色的怪物 (对应截图中的角色2颜色)
        ctx.fillStyle = '#8e44ad';
        ctx.beginPath();
        ctx.arc(e.x + e.w/2, e.y + e.h/2, e.w/2, 0, Math.PI*2);
        ctx.fill();
        // 怪物的眼睛
        ctx.fillStyle = 'white';
        ctx.beginPath(); ctx.arc(e.x + 10, e.y + 15, 5, 0, Math.PI*2); ctx.fill();
        ctx.beginPath(); ctx.arc(e.x + 30, e.y + 15, 5, 0, Math.PI*2); ctx.fill();
        
        // 敌人的移动逻辑
        e.x += e.vx * 2;
        e.y += e.vy * 2;
    });

    // ================== 绘制玩家 (Knight骑士) ==================
    // 用蓝色矩形代替骑士
    ctx.fillStyle = '#3498db';
    ctx.fillRect(player.x, player.y, player.w, player.h);
    ctx.fillStyle = '#2980b9';
    ctx.fillRect(player.x + 5, player.y - 5, 10, 10); // 头盔
    // 左手/武器
    ctx.fillStyle = '#ecf0f1';
    ctx.fillRect(player.x - 10, player.y + 5, 10, 5);
    ctx.fillRect(player.x - 10, player.y - 5, 10, 5); // 右手

    // ================== 碰撞检测 (对应积木中的 如果碰到) ==================
    checkCollision();

    // ================== 键盘控制移动 ==================
    const keys = window.keys || {};
    if (keys['w'] || keys['W'] || keys['ArrowUp']) player.y -= player.speed;
    if (keys['s'] || keys['S'] || keys['ArrowDown']) player.y += player.speed;
    if (keys['a'] || keys['A'] || keys['ArrowLeft']) player.x -= player.speed;
    if (keys['d'] || keys['D'] || keys['ArrowRight']) player.x += player.speed;
    
    // 限制玩家不能跑出屏幕
    player.x = Math.max(0, Math.min(canvas.width - player.w, player.x));
    player.y = Math.max(0, Math.min(canvas.height - player.h, player.y));

    // 触发下一帧
    requestAnimationFrame(gameLoop);
}

// ==========================================
// 3. 事件触发机制 (对应截图7、8的 广播与事件)
// ==========================================

// 对应图7的：当角色被点击 -> 隐藏 -> 广播 [消息1]
function triggerBroadcast1() {
    const item = document.getElementById('trigger-item');
    item.style.display = 'none'; // 隐藏道具

    // 对应图8的舞台：当接收到 [消息1] -> 下一个背景
    isSceneChanged = true; 
    setTimeout(() => { isSceneChanged = false; }, 3000);

    // 广播 [消息1] 后，疯狂生成一波敌人
    for(let i=0; i<10; i++) {
        setTimeout(spawnEnemy, i * 100); 
    }
}

// 监听键盘
document.addEventListener('keydown', e => {
    window.keys = window.keys || {};
    window.keys[e.key] = true;
});
document.addEventListener('keyup', e => {
    window.keys = window.keys || {};
    window.keys[e.key] = false;
});

// ==========================================
// 4. 启动游戏 (对应图1的 当绿旗被点击)
// ==========================================
function startGame() {
    hp = 0;
    score = 49;
    updateUI();
    spawnEnemy(); // 开始出怪
    gameLoop();   // 启动循环
}

startGame();
</script>
</body>
</html>